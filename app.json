{
  "name": "Inventory Management System",
  "description": "A comprehensive inventory management system with SQL Server database and role-based access control",
  "repository": "https://github.com/GauravShukla07/InventoryTracker",
  "logo": "https://cdn.jsdelivr.net/npm/lucide@latest/icons/package.svg",
  "keywords": ["inventory", "asset-management", "typescript", "react", "express", "mssql"],
  "image": "heroku/nodejs",
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "env": {
    "NODE_ENV": {
      "description": "Node.js environment",
      "value": "production"
    },
    "SESSION_SECRET": {
      "description": "Secret key for session encryption - use a long random string",
      "generator": "secret"
    },
    "SQL_SERVER_HOST": {
      "description": "SQL Server hostname and port",
      "required": true
    },
    "SQL_DATABASE": {
      "description": "SQL Server database name",
      "required": true
    },
    "SQL_USER": {
      "description": "SQL Server username",
      "required": true
    },
    "SQL_PASSWORD": {
      "description": "SQL Server password",
      "required": true
    }
  }
}