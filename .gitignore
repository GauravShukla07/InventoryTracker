# ========================================
# PRODUCTION-FOCUSED .gitignore
# Only production-necessary files are tracked
# ========================================

# Dependencies (never commit)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs (generated during deployment)
dist/
build/
server/public/

# Environment and Configuration Files
.env                           # Real environment variables (secrets)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database Files
*.db
*.sqlite
*.sqlite3

# Logs and Runtime Data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# Test Coverage
coverage/
*.lcov
.nyc_output

# Cache Directories
.npm
.eslintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.cache
.parcel-cache

# TypeScript
*.tsbuildinfo

# Framework-specific
.next
.nuxt
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor and IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ========================================
# PROJECT-SPECIFIC EXCLUSIONS
# ========================================

# Development and Debug Files
cookies.txt
fresh_cookies.txt
debug_cookies.txt
test_cookies.txt
test_new_cookies.txt
auth_test.txt
session_fix.txt
session_test.txt

# Development Scripts and Utilities (Backend only)
setup-sqlserver.js
test-sqlserver.js
debug-database-structure.js
test-alternative-configs.ts
test-sql-auth.ts
start-dev.bat

# Note: Keeping connection-related files that might be used by frontend:
# - connection-test.ts (might be used by UI)
# - debug-connection.ts (might have frontend utilities)
# - network-diagnostics.ts (might be used by frontend)
# - check-connection.ts (might be part of UI connection testing)

# Documentation and Notes (development-specific only)
attached_assets/
replit.md
*.backup

# Note: Keeping deployment and architecture docs as they're production-relevant:
# - DEPLOYMENT.md, DEPLOYMENT_GUIDE.md (production deployment)
# - Some connection docs might be needed for frontend integration

# Excluding only development troubleshooting docs:
CONNECTION_SOLUTIONS.md
CONNECTION_TIMEOUT_SOLUTIONS.md
CONNECTION_TROUBLESHOOTING.md
ROLE_BASED_AUTHENTICATION_SETUP.md
SQL_AUTHENTICATION_SETUP.md
SQL_SERVER_SETUP.md
TROUBLESHOOTING_SQL_CONNECTION.md

# Session and Runtime Files
sessions/
*.session

# Package managers
.yarn-integrity
*.tgz
.node_repl_history

# Archive and backup files
*.tar.gz
*.zip
*.rar

# Vite temp files
vite.config.ts.*

# Replit-specific
.replit

# ========================================
# WHAT GETS COMMITTED (Production Files):
# ========================================
# ✅ package.json & package-lock.json
# ✅ tsconfig.json, vite.config.ts, tailwind.config.ts
# ✅ client/ (React frontend source)
# ✅ server/ (Express backend source)
# ✅ shared/ (shared schemas and types)
# ✅ .env.example (template for environment setup)
# ✅ Procfile, render.yaml, app.json (deployment configs)
# ✅ postcss.config.js, components.json
# ✅ database-setup.sql (production database schema)
# ✅ DEPLOYMENT.md, DEPLOYMENT_GUIDE.md (deployment instructions)
# ✅ CODE_DOCUMENTATION.md, SYSTEM_ARCHITECTURE.md (production docs)
# ✅ DEPLOYMENT_CHECKLIST.md, DEPLOYMENT_COMPLETE.md (deployment info)
# ✅ connection-test.ts, debug-connection.ts (may be used by frontend)
# ✅ network-diagnostics.ts, check-connection.ts (UI connection features)
# ========================================